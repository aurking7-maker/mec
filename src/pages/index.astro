---
// ✦ Maestro Edil Carpi - Pagina Principale (SSG) ✦
// Performance & SEO ottimizzati per posizionamento su costruzioni/ristrutturazioni
// in provincia di Modena e Reggio Emilia
import '../styles/global.css';
import App from '../components/App.tsx';
import CookieConsent from '../components/CookieConsent.astro';
import { cities } from '../data/cities';

// ── Estrai città da cities.ts (SINGLE SOURCE OF TRUTH) ──
const cittaMO = cities.filter(c => c.province === 'MO').map(c => c.name);
const cittaRE = cities.filter(c => c.province === 'RE').map(c => c.name);

// ── Tutte le città servite (unione MO + RE) ──
const cittaServite = [...cittaMO, ...cittaRE];
const provinceDesc = `Modena (${cittaMO.join(', ')}) e Reggio Emilia (${cittaRE.join(', ')})`;

// ── Genera dynamic keywords from cities.ts data ──
const cittaKeywords = [
  ...cittaMO.map(c => `impresa edile ${c}`),
  ...cittaMO.map(c => `ristrutturazione ${c}`),
  ...cittaRE.map(c => `impresa edile ${c}`),
  ...cittaRE.map(c => `ristrutturazione ${c}`),
];

// ── Keyword stratificate per tutti i servizi (piccoli → grandi) ──
const keywords = [
  // Impresa edile generico
  "impresa edile Carpi", "impresa edile Modena", "impresa edile Reggio Emilia",
  "impresa edile Emilia-Romagna", "impresa di costruzioni Modena e Reggio Emilia",
  "costruzioni Modena", "costruzioni Reggio Emilia", "edilizia Carpi",
  "costruzioni Emilia-Romagna", "ditta edile Carpi", "ditta edile Modena",
  "azienda edile Reggio Emilia", "lavori edili Carpi", "lavori edili Modena",
  "lavori edili Reggio Emilia",

  // Ristrutturazioni
  "ristrutturazione casa Modena", "ristrutturazione appartamento Reggio Emilia",
  "ristrutturazione villa Carpi", "ristrutturazione chiavi in mano Modena",
  "ristrutturazione chiavi in mano Reggio Emilia", "ristrutturazione completa Carpi",
  "ristrutturazione appartamento Modena", "ristrutturazione villa Modena",
  "ristrutturazione casa Reggio Emilia", "ristrutturazione budget Modena",
  "ristrutturazione bagno Carpi", "ristrutturazione cucina Modena",
  "ristrutturazione bagno Modena", "ristrutturazione cucina Reggio Emilia",
  "ristrutturazione bagno Reggio Emilia", "ristrutturazione cucina Carpi",
  "ristrutturazione locale commerciale Modena", "ristrutturazione ufficio Reggio Emilia",

  // Costruzioni
  "costruzione casa Reggio Emilia", "costruzione villetta Reggio Emilia",
  "costruzione casa Modena", "costruzione villetta Modena",
  "costruzione edificio Carpi", "costruzione palazzina Modena",
  "nuova costruzione Reggio Emilia", "edilizia residenziale Modena",
  "edilizia residenziale Reggio Emilia", "costruzioni residenziali Carpi",

  // Ampliamenti e sopraelevazioni
  "ampliamento edificio Carpi", "sopraelevazione Modena",
  "ampliamento casa Modena", "ampliamento villa Reggio Emilia",
  "sopraelevazione Reggio Emilia", "ampliamento appartamento Carpi",

  // Restauro
  "restauro edificio storico Carpi", "restauro palazzo antico Modena",
  "recupero immobile Reggio Emilia", "restauro conservativo Modena",
  "restauro affreschi Reggio Emilia", "restauro facciate Carpi",
  "restauro edifici storici Modena", "recupero edilizio Reggio Emilia",
  "restauro monumenti Carpi", "patrimonio edilizio Modena",

  // Pavimenti e rivestimenti
  "pavimenti Modena", "rivestimenti Reggio Emilia", "posa piastrelle Carpi",
  "posa gres porcellanato Modena", "posa ceramica Reggio Emilia",
  "pavimentazione Carpi", "pavimento in gres Modena",
  "rivestimento pareti Reggio Emilia", "posa marmo Carpi",
  "posa pietra Modena", "pavimento legno Reggio Emilia",
  "sostituzione pavimento Modena", "rifacimento pavimento Carpi",
  "rivestimento bagno Carpi", "rivestimento cucina Modena",

  // Bagni e cucine
  "ristrutturazione bagno completo Modena", "ristrutturazione cucina completa Reggio Emilia",
  "bagno moderno Carpi", "cucina design Modena",
  "installazione sanitari Reggio Emilia", "posa rivestimenti bagno Carpi",
  "arredo bagno Reggio Emilia",

  // Cartongesso e controsoffitti
  "cartongesso Reggio Emilia", "controsoffitti Carpi",
  "parete cartongesso Modena", "controparete Reggio Emilia",
  "controsoffitto LED Carpi", "controsoffitto apribile Modena",
  "nicchie cartongesso Reggio Emilia", "pareti attrezzate Modena",

  // Tinteggiatura e finiture
  "tinteggiatura Modena", "stucco veneziano Reggio Emilia",
  "rasatura pareti Carpi", "pittura interna Reggio Emilia",
  "finiture decorative Carpi",

  // Consulenza e progettazione
  "consulenza progettazione edile Carpi", "progettazione architettonica Modena",
  "direzione lavori Reggio Emilia", "perizia tecnica Carpi",
  "pratiche edilizie Modena", "computo metrico Reggio Emilia",
  "sicurezza cantieri Carpi", "progetto edilizio Modena",

  // Efficientamento energetico
  "efficientamento energetico Carpi", "cappotto termico Modena",
  "isolamento termico Reggio Emilia", "isolamento acustico Carpi",
  "ristrutturazione energetica Modena", "bonus edilizi Reggio Emilia",
  "risparmio energetico Carpi",

  // Piccoli lavori e manutenzione
  "idraulico Carpi", "manutenzione casa Reggio Emilia",
  "montaggio mobili Carpi", "riparazioni murarie Modena",
  "piccoli lavori edili Reggio Emilia", "installazione sanitari Carpi",
  "sostituzione rubinetti Modena", "riparazione infissi Carpi",
  "montaggio porte Modena", "riparazione tetto Carpi",
  "montaggio TV a parete Carpi", "montaggio tende Modena",
  "riparazione serramenti Carpi",

  // Zona generica e long-tail
  "impresa edile vicino a me Modena", "impresa edile vicino a me Reggio Emilia",
  "miglior impresa edile Carpi", "miglior ristrutturatore Modena",
  "costo ristrutturazione bagno Modena", "costo ristrutturazione cucina Reggio Emilia",
  "preventivo ristrutturazione Carpi", "preventivo gratuito edile Modena",
  "ristrutturazione economica Reggio Emilia", "lavori edili prezzi Carpi",
  "manutenzione edilizia Modena",
  ...cittaKeywords,
].join(", ");

const SITE = 'https://www.maestroedilcarpi.it';
const BASE = '';
const BASE_URL = SITE;
