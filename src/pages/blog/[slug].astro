---
import LightLayout from '../../layouts/LightLayout.astro';
import { blogArticles, type BlogArticle } from '../../data/blog';
import { services } from '../../data/services';

export async function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: BlogArticle };

const BASE = '';
const SITE = 'https://www.maestroedilcarpi.it';
const canonicalUrl = `${SITE}/blog/${article.slug}/`;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.metaDescription,
  "datePublished": "2026-06-03",
  "dateModified": "2026-06-03",
  "author": {
    "@type": "Person",
    "name": "Maestro Edil Carpi"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Maestro Edil Carpi",
    "url": SITE
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": article.faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---

<LightLayout
  title={article.metaTitle}
  description={article.metaDescription}
  canonical={canonicalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <div class="blog-article">
    <div class="blog-article-inner">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="ls-breadcrumb">
        <a href={`${BASE}/`}>Home</a>
        <span class="ls-breadcrumb-sep">/</span>
        <a href={`${BASE}/blog/`}>Guide & Costi</a>
        <span class="ls-breadcrumb-sep">/</span>
        <span class="ls-breadcrumb-current">{article.title}</span>
      </nav>

      <!-- Hero -->
      <div class="blog-hero">
        <span class="blog-badge">{article.category}</span>
        <h1>{article.heroTitle}</h1>
        <p class="blog-hero-sub">{article.heroSubtitle}</p>
        <div class="blog-meta">
          <span>{article.date}</span>
          <span class="blog-meta-sep">·</span>
          <span>{article.readTime} di lettura</span>
        </div>
      </div>

      <!-- Content -->
      <div class="blog-content">
        {
          article.sections.map((section) => {
            if (section.type === 'h2') { return <h2>{section.content}</h2>; }
            if (section.type === 'h3') { return <h3>{section.content}</h3>; }
            if (section.type === 'p') { return <p>{section.content}</p>; }
            if (section.type === 'ul') {
              return <ul>{section.items!.map(item => <li>{item}</li>)}</ul>;
            }
            if (section.type === 'table') {
              if (section.rows) {
                return (
                  <div class="blog-table-wrap">
                    <table class="blog-table">
                      <tbody>
                        {section.rows.map(row => (
                          <tr><td><strong>{row.label}</strong></td><td>{row.value}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (section.cols) {
                return (
                  <div class="blog-table-wrap">
                    <table class="blog-table">
                      <thead><tr><th>{section.cols[0].label}</th><th>{section.cols[1].label}</th></tr></thead>
                      <tbody>
                        {section.cols.slice(1).map(col => (
                          <tr><td>{col.label}</td><td>{col.value}</td></tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
            }
            if (section.type === 'card') {
              return (
                <div class="blog-card">
                  <h3 class="blog-card-title">{section.title}</h3>
                  <p class="blog-card-text">{section.content}</p>
                </div>
              );
            }
            return null;
          })
        }
      </div>

      <!-- FAQ -->
      <h2>Domande Frequenti</h2>
      {article.faq.map(f => (
        <div class="blog-faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}

      <!-- CTA -->
      <div class="blog-cta">
        <h2>Richiedi un Preventivo Gratuito</h2>
        <p>Contattaci per un sopralluogo senza impegno a Carpi, Modena, Sassuolo o in tutta la provincia. Riceverai un preventivo chiaro e dettagliato.</p>
        <a href={`${BASE}/#contatti`} class="cta-btn">Richiedi Preventivo</a>
      </div>

      <!-- Related Articles -->
      <h2>Articoli Correlati</h2>
      <div class="blog-grid">
        {blogArticles.filter(a => a.slug !== article.slug).slice(0, 3).map(a => (
          <a href={`${BASE}/blog/${a.slug}/`} class="blog-card-link">
            <span class="blog-badge">{a.category}</span>
            <h3>{a.title}</h3>
            <p>{a.excerpt}</p>
            <div class="blog-meta">
              <span>{a.date}</span><span class="blog-meta-sep">·</span><span>{a.readTime}</span>
            </div>
          </a>
        ))}
      </div>

      <h2>I Nostri Servizi</h2>
      {services.map((s) => (
        <a href={`${BASE}/servizi/${s.slug}/`} class="service-link"><h3>{s.title} →</h3></a>
      ))}
    </div>
  </div>
</LightLayout>

<style>
  .blog-article {
    background: #f9f8f6;
    width: 100vw;
    max-width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: -6rem;
    margin-bottom: -4rem;
    padding-top: 6rem;
    padding-bottom: 4rem;
    overflow-x: hidden;
  }
  .blog-article-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .blog-article-inner h2 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(1.4rem, 2.8vw, 1.8rem);
    font-weight: 700;
    color: #1A1A1A;
    margin: 2.75rem 0 1.25rem;
    letter-spacing: -0.005em;
  }

  /* Hero */
  .blog-hero {
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid #e2d8c9;
    margin-bottom: 2rem;
  }
  .ls-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #56626D;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .ls-breadcrumb a { color: #56626D; text-decoration: none; transition: color 0.2s; }
  .ls-breadcrumb a:hover { color: #1A1A1A; }
  .ls-breadcrumb-sep { color: #C5A880; }
  .ls-breadcrumb-current { color: #1A1A1A; font-weight: 600; }

  .blog-badge {
    display: inline-block;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFFFFF;
    background: #1A1A1A;
    padding: 0.4rem 0.85rem;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }
  .blog-hero h1 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
  }
  .blog-hero-sub {
    color: #56626D;
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 0.78rem;
    color: #56626D;
  }
  .blog-meta-sep { color: #C5A880; }

  /* Content */
  .blog-content h2 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 700;
    color: #1A1A1A;
    margin: 2.5rem 0 1.1rem;
    letter-spacing: -0.005em;
  }
  .blog-content h3 {
    font-family: 'Raleway', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: #1A1A1A;
    margin: 1.5rem 0 0.5rem;
  }
  .blog-content p {
    color: #56626D;
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }
  .blog-content ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .blog-content ul li {
    padding: 0.55rem 0;
    color: #1A1A1A;
    font-size: 0.95rem;
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }
  .blog-content ul li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #C5A880;
    font-weight: 700;
  }

  /* Table */
  .blog-table-wrap {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
    -webkit-overflow-scrolling: touch;
  }
  .blog-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    min-width: 480px;
    background: white;
    border-radius: 6px;
    overflow: hidden;
  }
  .blog-table th {
    background: #2c2418;
    color: #ede9df;
    font-family: 'Raleway', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    padding: 0.65rem 0.85rem;
  }
  .blog-table td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid #ede5d8;
    color: #4a3f30;
    vertical-align: top;
    line-height: 1.5;
  }
  .blog-table tbody tr:hover {
    background: #fdfcfa;
  }

  /* Card */
  .blog-card {
    background: #ffffff;
    border: 1px solid #c8a96e;
    border-left: 4px solid #c8a96e;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    box-shadow: 0 2px 6px rgba(200,169,110,0.08);
  }
  .blog-card-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c2418;
    margin-bottom: 0.5rem;
  }
  .blog-card-text {
    color: #6b5f4e;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  /* FAQ */
  .blog-faq-item {
    margin-bottom: 1.5rem;
  }
  .blog-faq-item h3 {
    font-size: 1rem;
    color: #2c2418;
    font-family: 'Raleway', system-ui, sans-serif;
    font-weight: 600;
  }
  .blog-faq-item p {
    font-size: 0.9rem;
    color: #4a3f30;
  }

  /* CTA */
  .blog-cta {
    background: #ffffff;
    border: 1px solid #e2d8c9;
    border-radius: 8px;
    padding: 2rem;
    text-align: center;
    margin: 3rem 0;
    box-shadow: 0 2px 8px rgba(44,36,24,0.04);
  }
  .blog-cta h2 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #2c2418;
    margin-bottom: 0.75rem;
  }
  .blog-cta p {
    color: #6b5f4e;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .blog-cta .cta-btn {
    background: #C5A880;
    color: #1A1A1A;
    box-shadow: 0 4px 16px rgba(197, 168, 128, 0.25);
    transition: background 0.3s, transform 0.25s, box-shadow 0.3s;
  }
  .blog-cta .cta-btn:hover {
    background: #d4b890;
    color: #1A1A1A;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(197, 168, 128, 0.35);
  }

  /* Related grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin: 1rem 0 2rem;
  }
  .blog-card-link {
    display: block;
    padding: 1.25rem;
    background: #ffffff;
    border: 1px solid #e2d8c9;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 1px 3px rgba(44,36,24,0.04);
  }
  .blog-card-link:hover {
    border-color: #c8a96e;
    box-shadow: 0 4px 12px rgba(200,169,110,0.12);
  }
  .blog-card-link h3 {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    color: #2c2418;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .blog-card-link p {
    font-size: 0.8rem;
    color: #6b5f4e;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
</style>